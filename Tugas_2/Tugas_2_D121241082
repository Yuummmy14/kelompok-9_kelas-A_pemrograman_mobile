void main() {
  // Daftar harga
  List<int> harga = [10000, 15000, 20000, 25000];

  // Daftar belanjaan
  List<String> belanjaan = [
    "Roti",
    "Susu",
    "Kopi",
    "Biskuit"
  ];

  int total = 0;

  print("=== DAFTAR BELANJA ===");

  for (int i = 0; i < belanjaan.length; i++) {
    print("${belanjaan[i]} = Rp${harga[i]}");
    total += harga[i];
  }

  print("\nTotal belanja: Rp$total");

  // Menentukan diskon
  int diskon = 0;

  if (total >= 50000) {
    diskon = 10;
  } else if (total >= 30000) {
    diskon = 5;
  } else {
    diskon = 0;
  }

  print("Diskon: $diskon%");

  // Menghitung total akhir
  int potongan = total * diskon ~/ 100;
  int totalAkhir = total - potongan;

  print("Potongan: Rp$potongan");
  print("Total akhir: Rp$totalAkhir");
}
